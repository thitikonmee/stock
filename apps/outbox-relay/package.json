{
  "name": "@stockos/outbox-relay",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stockos/config": "workspace:^",
    "@stockos/database": "workspace:^",
    "@stockos/queue": "workspace:^",
    "@stockos/shared": "workspace:^"
  },
  "devDependencies": {
    "tsc-watch": "^7.2.1"
  }
}
