# =============================================================================
# StockOS environment variables
# Local: copy to .env.  dev/staging/prod: inject from AWS Secrets Manager / SSM.
# Values below are LOCAL DEVELOPMENT placeholders only — never real credentials.
# =============================================================================

# --- General ---
NODE_ENV=development
APP_ENV=local                          # local | dev | staging | prod
LOG_LEVEL=debug
SERVICE_NAME=api                       # api | webhook-gateway | worker | scheduler | outbox-relay
PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
PUBLIC_WEB_BASE_URL=http://localhost:3100
PUBLIC_POS_BASE_URL=http://localhost:3200
WEBHOOK_BASE_URL=http://localhost:3001  # public URL registered with marketplaces (tunnel in local)
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
DEFAULT_TIMEZONE=Asia/Bangkok

# --- PostgreSQL ---
POSTGRES_USER=stockos_admin
POSTGRES_PASSWORD=stockos_admin
POSTGRES_DB=stockos
DATABASE_URL=postgres://stockos_app:stockos_app@localhost:5432/stockos            # app role (NOBYPASSRLS)
DATABASE_URL_PLATFORM=postgres://stockos_platform:stockos_platform@localhost:5432/stockos  # cross-tenant jobs (audited)
DATABASE_URL_ADMIN=postgres://stockos_admin:stockos_admin@localhost:5432/stockos  # migrations only
DATABASE_URL_READONLY=postgres://stockos_readonly:stockos_readonly@localhost:5432/stockos
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=stockos
QUEUE_DEFAULT_ATTEMPTS=8
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=500

# --- Auth ---
JWT_ISSUER=https://api.stockos.local
JWT_AUDIENCE=stockos-api
JWT_KID=local-1
JWT_PRIVATE_KEY_PATH=.secrets/jwt-private.pem      # ES256 (P-256); generate: pnpm gen:keys
JWT_PREVIOUS_PUBLIC_KEYS_PATH=                    # optional JSON {"kid": "<public PEM>"} during key rotation
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_ABSOLUTE_DAYS=90
DEVICE_TOKEN_TTL_DAYS=7
POS_OFFLINE_GRACE_HOURS=72
PASSWORD_ARGON2_MEMORY_KB=65536

# --- Encryption (field-level envelope encryption) ---
KMS_PROVIDER=local                     # local | aws
KMS_KEY_ID=                            # AWS KMS CMK ARN (non-local)
LOCAL_MASTER_KEY_BASE64=               # local only: 32 random bytes base64 (pnpm gen:keys)

# --- Object storage (product images) ---
# S3_BUCKET_UPLOADS unset = images are written to UPLOADS_LOCAL_DIR on local disk (no S3/Docker
# needed for local dev). Set it (+ the vars below) to use an S3-compatible bucket instead.
S3_ENDPOINT=http://localhost:9000      # empty for AWS; MinIO/R2 endpoint otherwise
S3_REGION=ap-southeast-7
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_UPLOADS=
S3_BUCKET_EXPORTS=stockos-exports
S3_BUCKET_ARCHIVE=stockos-archive
S3_FORCE_PATH_STYLE=true
UPLOADS_LOCAL_DIR=.uploads

# --- Email / Notifications ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="StockOS <no-reply@stockos.local>"
LINE_CHANNEL_ACCESS_TOKEN=             # LINE Messaging API (Official Account)
LINE_CHANNEL_SECRET=

# --- Marketplaces (verify values with each platform's developer console) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_API_BASE_URL=https://partner.test-stable.shopeemobile.com   # sandbox; prod: https://partner.shopeemobile.com
SHOPEE_REDIRECT_URL=http://localhost:3000/api/v1/channels/shopee/callback
# Dev/demo only, never staging/prod: point the adapter at an in-memory fixture instead of real
# Shopee (needs SHOPEE_PARTNER_ID/KEY set to any placeholder value too).
SHOPEE_FIXTURE_MODE=false

LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_API_BASE_URL=https://api.lazada.co.th/rest
LAZADA_AUTH_BASE_URL=https://auth.lazada.com/rest
LAZADA_REDIRECT_URL=http://localhost:3000/api/v1/channels/lazada/callback
# Dev/demo only, never staging/prod — same caveat as SHOPEE_FIXTURE_MODE.
LAZADA_FIXTURE_MODE=false

TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com
TIKTOK_SERVICE_ID=
TIKTOK_REDIRECT_URL=http://localhost:3000/api/v1/channels/tiktok/callback

MARKETPLACE_MOCK=true                  # route adapters to local mock server
MARKETPLACE_MOCK_URL=http://localhost:4010

# --- Channel sync tuning ---
STOCK_PUSH_DEBOUNCE_MS=1500
STOCK_PUSH_LOW_STOCK_THRESHOLD=5
CHANNEL_POLL_INTERVAL_SEC=300
CHANNEL_POLL_OVERLAP_SEC=600
WEBHOOK_MAX_ATTEMPTS=10
RESERVATION_EXPIRY_SWEEP_SEC=60

# --- Payments ---
PAYMENT_PROVIDER=opn                   # opn | 2c2p | none
OPN_PUBLIC_KEY=
OPN_SECRET_KEY=
OPN_WEBHOOK_SECRET=
PROMPTPAY_STATIC_ID=                   # merchant PromptPay ID for offline static QR (per tenant setting overrides)

# --- Billing (SaaS) ---
BILLING_PROVIDER=none                  # stripe | opn | none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=${SERVICE_NAME}
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0            # prod: 0.1 (+ tail sampling for errors in collector)
SENTRY_DSN=
PUBLIC_SENTRY_DSN=

# --- Rate limits ---
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_TENANT_PER_MIN=6000
RATE_LIMIT_LOGIN_PER_15MIN=10

# --- Feature flags ---
FEATURE_FLAGS_PROVIDER=db              # db | unleash
